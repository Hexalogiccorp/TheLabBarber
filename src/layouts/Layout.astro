---
import Footer from "../components/layout/Footer.astro";
import Navbar from "../components/layout/Navbar.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Lab Barber 506 | Barbería en Siquirres, Costa Rica",
  description = "Barbería profesional en Siquirres, Costa Rica. Cortes, barba y afeitado clásico por manos expertas. Reserva tu cita hoy mismo.",
} = Astro.props;

const siteUrl = "https://thelabbarber506.com";
const ogImage = `${siteUrl}/casadelcorte.png`;

const schema = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  "name": "The Lab Barber 506",
  "description": description,
  "url": siteUrl,
  "telephone": "+506XXXXXXXX",
  "image": ogImage,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Centro Comercial Los Maderos, diagonal al Pani, segunda planta., Guápiles, Costa Rica",
    "addressLocality": "Guapiles",
    "addressRegion": "Limón",
    "addressCountry": "CR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 10.100774,
    "longitude": -83.504631
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "07:30",
      "closes": "19:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday"],
      "opens": "08:30",
      "closes": "13:30"
    }
  ],
  "sameAs": [
    "https://www.tiktok.com/@the.lab.barber1"
  ]
};
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/casadelcorte.png" />
		<link rel="icon" href="/casadelcorte.png" />
		<meta name="generator" content={Astro.generator} />

		<link rel="preload" href="/fonts/DM_Sans/DMSans-VariableFont_opsz,wght.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
		<link rel="preload" href="/HeroBackground.webp" as="image" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow" />
		<link rel="canonical" href={siteUrl} />

		<meta property="og:type"        content="website" />
		<meta property="og:title"       content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url"         content={siteUrl} />
		<meta property="og:image"       content={ogImage} />
		<meta property="og:locale"      content="es_CR" />
		<meta property="og:site_name"   content="La Casa Del Corte" />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
	</head>
	<body class="bg-[#0D0D0D]">
    <Navbar/>
		<main>
			<slot />
		</main>
    <Footer/>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		scroll-behavior: smooth;
	}
</style>
