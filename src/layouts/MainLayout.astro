---
import Footer from "../components/layout/Footer.astro";
import Navbar from "../components/layout/Navbar.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Lab Barber 506 | Barbería en Siquirres, Costa Rica",
  description = "Barbería profesional en Siquirres, Costa Rica. Cortes, barba y afeitado clásico por manos expertas. Reserva tu cita hoy mismo.",
} = Astro.props;

const siteUrl = "https://thelabbarber506.com";
const ogImage = `${siteUrl}/logoHero.webp`;

const schema = {
  "@context": "https://schema.org",
  "@type": "HairSalon",
  "name": "The Lab Barber 506",
  "description": description,
  "url": siteUrl,
  "telephone": "+506XXXXXXXX",
  "image": ogImage,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "De Bar Martel 100 metros norte, local a mano derecha",
    "addressLocality": "Siquirres",
    "addressRegion": "Limón",
    "addressCountry": "CR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 10.100774,
    "longitude": -83.504631
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "07:30",
      "closes": "19:00"
    },
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Sunday"],
      "opens": "08:30",
      "closes": "13:30"
    }
  ],
  "sameAs": [
    "https://www.tiktok.com/@the.lab.barber1"
  ]
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logoHero.webp" />
    <link rel="icon" href="/logoHero.webp" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href="/fonts/DM_Sans/DMSans-VariableFont_opsz,wght.ttf" as="font" type="font/ttf" crossorigin="anonymous" />
    <link rel="preload" href="/HeroBackground.webp" as="image" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={siteUrl} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:locale"      content="es_CR" />
    <meta property="og:site_name"   content="The Lab Barber 506" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="bg-[#0D0D0D]">

    <div id="page-content">
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <svg
      id="splash-clip-svg"
      style="position:fixed;width:0;height:0;overflow:hidden;pointer-events:none;"
      aria-hidden="true"
    >
      <defs>
        <clipPath id="splashClip" clipPathUnits="userSpaceOnUse">
          <path
            id="splash-clip-path"
            clip-rule="evenodd"
            d="M 0 0 H 10000 V 10000 H 0 Z"
          />
        </clipPath>
      </defs>
    </svg>

   
    <div id="splash-wrapper">

      <div class="splash">

      
        <div class="splash__bg">
          <img src="/barber-main.webp" alt="" class="splash__bg-img" />
          <div class="splash__bg-overlay"></div>
        </div>

     
        <div class="splash__content">

         
          <div class="splash__logo-wrap">
            <img
              src="/the-lab-barber.png"
              alt="TLB 506 – The Lab Barber"
              class="splash__logo"
            />
          </div>

          <!-- Loader section -->
          <div class="splash__loader">

            <!-- Erlenmeyer flask SVG -->
            <div class="splash__icon">
              <svg
                viewBox="0 0 56 78"
                style="overflow: visible;"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                class="tools-svg"
                aria-hidden="true"
              >
                <!-- Flask glass (Erlenmeyer shape) -->
                <path
                  d="M21,12 L21,28 C21,35 5,40 4,46 L4,66 Q4,74 28,74 Q52,74 52,66 L52,46 C51,40 35,35 35,28 L35,12 Z"
                  fill="rgba(186,224,28,0.08)"
                  stroke="#BAE01C"
                  stroke-width="2.2"
                  stroke-linejoin="round"
                />
                <!-- Liquid fill -->
                <path
                  d="M8,56 Q28,52 48,56 L48,66 Q48,71 28,71 Q8,71 8,66 Z"
                  fill="rgba(186,224,28,0.5)"
                />
                <!-- Neck opening rim -->
                <line x1="19" y1="11" x2="37" y2="11"
                  stroke="#BAE01C" stroke-width="2.8" stroke-linecap="round"/>

                <!-- Bubbles inside liquid -->
                <circle cx="17" cy="68" r="2.2" fill="rgba(255,255,255,0.28)" opacity="0">
                  <animate attributeName="cy" values="68;54" dur="1.7s" repeatCount="indefinite" begin="0.4s"/>
                  <animate attributeName="opacity" values="0;0.55;0" keyTimes="0;0.1;1" dur="1.7s" repeatCount="indefinite" begin="0.4s"/>
                </circle>
                <circle cx="38" cy="68" r="1.5" fill="rgba(255,255,255,0.22)" opacity="0">
                  <animate attributeName="cy" values="70;58" dur="2.0s" repeatCount="indefinite" begin="1.1s"/>
                  <animate attributeName="opacity" values="0;0.45;0" keyTimes="0;0.1;1" dur="2.0s" repeatCount="indefinite" begin="1.1s"/>
                </circle>
                <circle cx="27" cy="65" r="1.8" fill="rgba(255,255,255,0.2)" opacity="0">
                  <animate attributeName="cy" values="68;55" dur="1.5s" repeatCount="indefinite" begin="1.7s"/>
                  <animate attributeName="opacity" values="0;0.4;0" keyTimes="0;0.1;1" dur="1.5s" repeatCount="indefinite" begin="1.7s"/>
                </circle>

              
                <circle cx="28" cy="10" r="2.5" fill="#BAE01C" opacity="0">
                  <animate attributeName="cy" values="10;-28" dur="1.8s" repeatCount="indefinite" begin="0s"/>
                  <animate attributeName="opacity" values="0;1;0" keyTimes="0;0.1;1" dur="1.8s" repeatCount="indefinite" begin="0s"/>
                  <animate attributeName="r" values="2.5;5.5" dur="1.8s" repeatCount="indefinite" begin="0s"/>
                </circle>
                <circle cx="24" cy="10" r="2" fill="#BAE01C" opacity="0">
                  <animate attributeName="cy" values="10;-20" dur="1.4s" repeatCount="indefinite" begin="0.65s"/>
                  <animate attributeName="cx" values="24;18" dur="1.4s" repeatCount="indefinite" begin="0.65s"/>
                  <animate attributeName="opacity" values="0;0.9;0" keyTimes="0;0.12;1" dur="1.4s" repeatCount="indefinite" begin="0.65s"/>
                  <animate attributeName="r" values="2;4" dur="1.4s" repeatCount="indefinite" begin="0.65s"/>
                </circle>
                <circle cx="32" cy="10" r="1.6" fill="#BAE01C" opacity="0">
                  <animate attributeName="cy" values="10;-22" dur="2.2s" repeatCount="indefinite" begin="1.2s"/>
                  <animate attributeName="cx" values="32;38" dur="2.2s" repeatCount="indefinite" begin="1.2s"/>
                  <animate attributeName="opacity" values="0;0.8;0" keyTimes="0;0.12;1" dur="2.2s" repeatCount="indefinite" begin="1.2s"/>
                  <animate attributeName="r" values="1.6;3.5" dur="2.2s" repeatCount="indefinite" begin="1.2s"/>
                </circle>
                <circle cx="26" cy="10" r="1.2" fill="#BAE01C" opacity="0">
                  <animate attributeName="cy" values="10;-14" dur="1.1s" repeatCount="indefinite" begin="1.9s"/>
                  <animate attributeName="cx" values="26;22" dur="1.1s" repeatCount="indefinite" begin="1.9s"/>
                  <animate attributeName="opacity" values="0;0.7;0" keyTimes="0;0.15;1" dur="1.1s" repeatCount="indefinite" begin="1.9s"/>
                </circle>
              </svg>
            </div>

       
            <p class="splash__label">CARGANDO...</p>

          </div>
        </div>
      </div>

     
      <div id="transition-bg" aria-hidden="true"></div>

    </div>

   
    <svg
      id="clipper-border-svg"
      style="position:fixed;inset:0;width:100%;height:100%;z-index:62;pointer-events:none;overflow:visible;"
      aria-hidden="true"
    >
      <path
        id="clipper-border-path"
        fill="none"
        stroke="#BAE01C"
        stroke-width="2.5"
        stroke-linejoin="round"
        opacity="0"
      />
    </svg>

   
    <Navbar />

  </body>
</html>

<style is:global>
  html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    scroll-behavior: smooth;
  }

</style>

<style>

  #splash-wrapper {
    position: fixed;
    inset: 0;
    z-index: 61;
    background: #0D0D0D;
    will-change: clip-path;
    contain: layout style;
   
  }


  .splash {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    animation: page-in 0.6s ease-out both;
  }

  @keyframes page-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ─── Background ─────────────────────────────────── */
  .splash__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .splash__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    filter: brightness(0.35) saturate(0.8);
    transform: scale(1.04);
    animation: bg-drift 18s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes bg-drift {
    from { transform: scale(1.04) translateY(0); }
    to   { transform: scale(1.04) translateY(-2%); }
  }

  .splash__bg-overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 70% 45% at 50% 30%, rgba(186,224,28,0.04) 0%, transparent 60%),
      linear-gradient(to bottom,
        rgba(0,0,0,0.20)  0%,
        rgba(0,0,0,0.10) 20%,
        rgba(0,0,0,0.50) 45%,
        rgba(0,0,0,0.88) 58%,
        rgba(0,0,0,0.97) 70%,
        rgba(0,0,0,1.00) 100%
      );
  }

  .splash__content {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding:
      max(env(safe-area-inset-top, 0px) + 6vh, 40px)
      clamp(24px, 6vw, 80px)
      max(env(safe-area-inset-bottom, 0px) + 7vh, 44px);
  }


  .splash__logo-wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: logo-in 0.9s cubic-bezier(0.34, 1.5, 0.64, 1) 0.25s both;
  }

  .splash__logo {
    width: clamp(100px, 72vw, 400px);
    max-height: 62vh;
    object-fit: contain;
    filter:
      drop-shadow(0 0 28px rgba(186,224,28, 0.35))
      drop-shadow(0 0 72px rgba(186,224,28, 0.14));
    animation: logo-glow 3.5s ease-in-out 1.2s infinite alternate;
    will-change: filter;
  }

  @keyframes logo-in {
    from { opacity: 0; transform: scale(0.8) translateY(24px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }

  @keyframes logo-glow {
    from {
      filter:
        drop-shadow(0 0 28px rgba(186,224,28, 0.35))
        drop-shadow(0 0 72px rgba(186,224,28, 0.14));
    }
    to {
      filter:
        drop-shadow(0 0 38px rgba(186,224,28, 0.55))
        drop-shadow(0 0 90px rgba(186,224,28, 0.25));
    }
  }


  .splash__loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(14px, 2.5vh, 20px);
    width: 100%;
    animation: loader-in 0.7s ease-out 0.65s both;
  }

  @keyframes loader-in {
    from { opacity: 0; transform: translateY(22px); }
    to   { opacity: 1; transform: translateY(0); }
  }


  .splash__icon {
    animation: icon-float 2.2s ease-in-out infinite;
    padding: clamp(14px, 3.5vw, 22px);
    will-change: transform;
  }

  @keyframes icon-float {
    0%, 100% { transform: translateY(0px);  }
    50%       { transform: translateY(-6px); }
  }

  .tools-svg {
    width: clamp(58px, 14vw, 80px);
    height: auto;
  }


  .splash__label {
    font-family: 'Rajdhani', system-ui, sans-serif;
    font-size: clamp(10px, 2.4vw, 12px);
    font-weight: 600;
    letter-spacing: 0.4em;
    text-indent: 0.4em;
    color: rgba(255,255,255,0.5);
    text-transform: uppercase;
    animation: label-pulse 2.4s ease-in-out 1.2s infinite;
  }

  @keyframes label-pulse {
    0%, 100% { opacity: 0.5;  }
    50%       { opacity: 0.85; }
  }

 
  #clipper-border-svg {
    filter: drop-shadow(0 0 5px #BAE01C) drop-shadow(0 0 12px rgba(186,224,28,0.5));
    will-change: filter;
  }


  #transition-bg {
    position: absolute;
    inset: 0;
    z-index: 2;
    transition: opacity 0.5s ease;
    background: rgba(0, 0, 0, 0.495);
    opacity: 0;
    pointer-events: none;
  }
</style>

<script>
  function removeSplash() {
    document.getElementById('splash-wrapper')?.remove();
    document.getElementById('splash-clip-svg')?.remove();
    document.getElementById('clipper-border-svg')?.remove();
    document.body.style.overflow = '';
  }

  
  if (sessionStorage.getItem('splashSeen')) {
    removeSplash();
  } else {
    document.body.style.overflow = 'hidden';

    window.addEventListener('load', () => {
      const SPLASH_WAIT_MS = 3000;
      const DURATION_MS    = 1300;
      const MAX_SCALE      = 45;

      function cubicEaseIn(t: number): number { return t * t * t; }

      function buildClipperPath(s: number, cx: number, cy: number): string {
        const p = (px: number, py: number) =>
          `${cx + s * (px - 28)},${cy + s * (py - 53)}`;
        return [
          `M ${p(12,4)} Q ${p(4,4)} ${p(4,12)}`,
          `L ${p(4,80)} L ${p(2,80)} L ${p(2,92)}`,
          `L ${p(6,92)} L ${p(6,102)} L ${p(11,102)} L ${p(11,92)}`,
          `L ${p(12,92)} L ${p(12,102)} L ${p(17,102)} L ${p(17,92)}`,
          `L ${p(18,92)} L ${p(18,102)} L ${p(23,102)} L ${p(23,92)}`,
          `L ${p(24,92)} L ${p(24,102)} L ${p(29,102)} L ${p(29,92)}`,
          `L ${p(30,92)} L ${p(30,102)} L ${p(35,102)} L ${p(35,92)}`,
          `L ${p(36,92)} L ${p(36,102)} L ${p(41,102)} L ${p(41,92)}`,
          `L ${p(42,92)} L ${p(42,102)} L ${p(47,102)} L ${p(47,92)}`,
          `L ${p(54,92)} L ${p(54,80)} L ${p(52,80)} L ${p(52,12)}`,
          `Q ${p(52,4)} ${p(44,4)} Z`,
        ].join(' ');
      }

      setTimeout(() => {
        const bg = document.getElementById('transition-bg');
        if (bg) bg.style.opacity = '1';

        const wrapper = document.getElementById('splash-wrapper');
        if (wrapper) wrapper.style.clipPath = 'url(#splashClip)';

        const clipPathEl = document.getElementById('splash-clip-path');
        if (!clipPathEl) return;
        const clipEl = clipPathEl as Element;

        const W  = window.innerWidth;
        const H  = window.innerHeight;
        const cx = W / 2;
        const cy = H / 2;
        let startTime: number | null = null;

        const borderPathEl = document.getElementById('clipper-border-path') as SVGPathElement | null;
        if (borderPathEl) borderPathEl.setAttribute('opacity', '0.85');

        function tick(now: number): void {
          if (startTime === null) startTime = now;
          const t = Math.min((now - startTime) / DURATION_MS, 1);
          const s = cubicEaseIn(t) * MAX_SCALE;

          const clipperPath = buildClipperPath(s, cx, cy);
          clipEl.setAttribute('d', `M 0 0 H ${W} V ${H} H 0 Z ${clipperPath}`);
          borderPathEl?.setAttribute('d', clipperPath);

          if (t < 1) {
            requestAnimationFrame(tick);
          } else {
            sessionStorage.setItem('splashSeen', '1');
            removeSplash();
          }
        }

        requestAnimationFrame(tick);
      }, SPLASH_WAIT_MS);
    });
  }
</script>
