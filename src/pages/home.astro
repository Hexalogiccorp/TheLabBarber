---
import Layout from '../layouts/Layout.astro';
---

<Layout title="The Lab Barber 506 | TLB">
  <div class="home">
    <img
      src="/casadelcorte.png"
      alt="Barber Shop"
      class="home__logo"
    />
  </div>
</Layout>

<style>
  .home {
    position: fixed;
    inset: 0;
    background: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    animation: home-in 0.5s ease-out both;
  }

  @keyframes home-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .home__logo {
    width: clamp(180px, 55vw, 340px);
    filter:
      drop-shadow(0 0 32px rgba(229,158,72,0.3))
      drop-shadow(0 0 80px rgba(229,158,72,0.12));
    animation:
      logo-appear 0.7s cubic-bezier(0.34,1.4,0.64,1) 0.15s both,
      logo-float  4s ease-in-out 0.9s infinite alternate;
  }

  @keyframes logo-appear {
    from { opacity: 0; transform: scale(0.88); }
    to   { opacity: 1; transform: scale(1); }
  }

  @keyframes logo-float {
    from { transform: translateY(0px); }
    to   { transform: translateY(-10px); }
  }
</style>
