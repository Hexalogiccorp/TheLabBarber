---
import { barbers } from '../../data/barbers';
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  return barbers.map(barber => ({
    params: { slug: barber.slug },
    props: { barber },
  }));
}

const { barber } = Astro.props;
const { firstName, lastName, photo, role, experience, calUrl } = barber;

const calLink = calUrl ? calUrl.replace('https://cal.com/', '') : null;
---

<Layout title={`${firstName} ${lastName} | The Lab Barber 506`}>
  <div class="min-h-screen max-w-3xl mx-auto flex flex-col gap-10 pt-[clamp(80px,12vw,120px)] px-[clamp(16px,6vw,80px)] pb-[clamp(48px,8vw,80px)]">


    <a
      href="/#reservar"
      class="anim anim-1 inline-flex items-center gap-2 self-start border border-[#E59E48] px-4 py-2 text-xs font-bold tracking-widest uppercase text-white transition-all duration-200 hover:bg-[#E59E48] hover:text-[#0D0D0D] active:bg-[#E59E48] active:text-[#0D0D0D] active:scale-95"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      VOLVER
    </a>


    <section class="flex gap-[clamp(20px,5vw,48px)] items-start">

      <div class="anim anim-2 relative shrink-0 w-[clamp(130px,38vw,220px)] aspect-10/11">
        <img
          src={photo}
          alt={`Foto de ${firstName} ${lastName}`}
          class="w-full h-full object-cover object-top block"
        />
        <div aria-hidden="true" class="absolute top-0 left-0 w-5 h-5 border-t-2 border-l-2 border-[#E59E48] opacity-80 pointer-events-none"></div>
        <div aria-hidden="true" class="absolute bottom-0 right-0 w-5 h-5 border-b-2 border-r-2 border-[#E59E48] opacity-80 pointer-events-none"></div>
      </div>


      <div class="anim anim-3 flex flex-col gap-2 pt-1">
        <h1 class="text-[clamp(1.6rem,5vw,2.4rem)] font-extrabold leading-tight text-white m-0">
          <span class="text-[#F2CEA2]">{firstName}</span> {lastName}
        </h1>
        <p class="text-xs font-semibold tracking-wider uppercase text-white/40 m-0">{role}</p>
        <p class="text-[clamp(0.82rem,2.5vw,0.95rem)] text-white/65 leading-relaxed mt-1">
          Barbero con {experience} año{experience !== 1 ? 's' : ''} de experiencia en <span class="text-[#F2CEA2]">La Casa Del Corte</span>
        </p>

      </div>
    </section>


    <section class="anim anim-4 flex flex-col gap-6">
      <h2 class="flex items-center gap-3 flex-wrap text-[clamp(1.3rem,4.5vw,2rem)] font-extrabold text-white leading-tight m-0">
        Reserva una cita con
        <span class="text-[#F2CEA2]">{firstName}</span>
      </h2>

      {calLink ? (
        <div
          id="my-cal-inline"
          class="w-full rounded-none border border-[#6B4415] overflow-hidden"
          style="min-height:600px"
        ></div>
      ) : (
        <p class="text-white/50 text-sm">Reservas no disponibles por el momento.</p>
      )}
    </section>

  </div>
</Layout>

{calLink && (
  <script is:inline define:vars={{ calLink }}>
    (function (C, A, L) {
      let p = function (a, ar) { a.q.push(ar); };
      let d = C.document;
      C.Cal = C.Cal || function () {
        let cal = C.Cal;
        let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {};
          cal.q = cal.q || [];
          d.head.appendChild(d.createElement("script")).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api = function () { p(api, arguments); };
          const namespace = ar[1];
          api.q = api.q || [];
          if (typeof namespace === "string") {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar);
            p(cal, [L, namespace, ar[2]]);
          } else {
            p(cal, ar);
          }
          return;
        }
        p(cal, ar);
      };
    })(window, "https://app.cal.com/embed/embed.js", "init");

    Cal("init", 
      { 
        origin: "https://cal.com",
        locale: "es",
      }
    );

    Cal("inline", {
      elementOrSelector: "#my-cal-inline",
      config: {
        layout: "month_view",
      },
      calLink: calLink,
    });

    Cal("ui", {
      theme: "dark",
      cssVarsPerTheme: { dark: { "cal-brand": "#E59E48" } },
      hideEventTypeDetails: false,
      layout: "month_view",
    });
  </script>
)}

<style>
  @keyframes fade-up {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0);    }
  }

  .anim {
    animation: fade-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .anim-1 { animation-delay: 0.05s; }
  .anim-2 { animation-delay: 0.18s; }
  .anim-3 { animation-delay: 0.28s; }
  .anim-4 { animation-delay: 0.42s; }
</style>
