---
interface Props {
  photo: string;
  name: string;
  role: string;
  whatsapp?: string;
  reserveHref?: string;
}
const {
  photo,
  name,
  role,
  whatsapp = "#",
  reserveHref = "#reservar",
} = Astro.props;
---

<article
  class="barber-card relative flex flex-col w-full"
  style="border: 1px solid #325604; background: #141414;"
>
  <div class="relative overflow-hidden" style="aspect-ratio: 3/3.2;">
    <img
      src={photo}
      alt={`Foto de ${name}`}
      loading="lazy"
      class="w-full h-full object-cover object-top"
    />
    <div aria-hidden="true" class="absolute top-0 left-0 w-8 h-8 border-t-2 border-l-2 z-20 pointer-events-none" style="border-color:#BAE01C; opacity:0.75;"></div>
    <div aria-hidden="true" class="absolute bottom-0 right-0 w-8 h-8 border-b-2 border-r-2 z-20 pointer-events-none" style="border-color:#BAE01C; opacity:0.75;"></div>
  </div>

  <div class="relative flex flex-col px-5 pt-4 pb-10 overflow-hidden bg-[#0D0D0D]" style="border-top: 1px solid #325604;">

    <img
      src="/sissors.webp"
      alt=""
      aria-hidden="true"
      class="absolute inset-y-0 right-0 h-full w-auto opacity-40 pointer-events-none select-none rotate-[-10deg] translate-x-4"
    />

    <div class="flex items-start justify-between gap-2 relative z-10">
      <div class="flex flex-col gap-0.5">
        <h3 class="text-white font-bold text-xl leading-tight">{name}</h3>
        <p class="text-sm font-medium" style="color:#BAE01C;">{role}</p>
      </div>

      <a
        href={whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Contactar a ${name} por WhatsApp`}
        class="mt-1 shrink-0 opacity-90 hover:opacity-100 transition-opacity"
      >
        <svg viewBox="0 0 24 24" width="28" height="28" fill="#BAE01C" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
      </a>
    </div>

    <a
      href={reserveHref}
      aria-label={`Reservar turno con ${name}`}
      class="reserve-btn relative z-10 mt-5 flex items-center justify-center gap-2 w-full py-3 text-sm font-bold tracking-widest uppercase overflow-hidden"
      style="background:#BAE01C; color:#141414;"
    >
      Reservar tu turno
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
    </a>

    <div aria-hidden="true" class="absolute bottom-0 left-0 right-0" style="height:2px; pointer-events:none;">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none">
        <defs>
          <filter id="card-spray-1" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.85 0.28" numOctaves="3" stitchTiles="stitch" result="noise"/>
            <feColorMatrix in="noise" type="matrix"
              values="0 0 0 0 0.196
                      0 0 0 0 0.337
                      0 0 0 0 0.016
                      0 0 0 26 -12.5"/>
          </filter>
          <filter id="card-spray-2" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.35 0.12" numOctaves="2" seed="7" stitchTiles="stitch" result="noise"/>
            <feColorMatrix in="noise" type="matrix"
              values="0 0 0 0 0.196
                      0 0 0 0 0.337
                      0 0 0 0 0.016
                      0 0 0 30 -16"/>
          </filter>
        </defs>
        <rect width="100%" height="100%" filter="url(#card-spray-1)"/>
        <rect width="100%" height="100%" filter="url(#card-spray-2)" opacity="0.5"/>
      </svg>
    </div>
  </div>
</article>

<style>
  .barber-card {
    opacity: 0;
    transform: translateY(36px) scale(0.97);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }
  .barber-card.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  .barber-card.is-visible:hover {
    transform: translateY(-6px);
    box-shadow:
      0 20px 40px rgba(186, 224, 28, 0.10),
      0 0 0 1px rgba(186, 224, 28, 0.25);
    transition:
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }

  .reserve-btn::after {
    content: '';
    position: absolute;
    top: 0;
    left: -75%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      105deg,
      transparent 20%,
      rgba(255, 255, 255, 0.28) 50%,
      transparent 80%
    );
    transform: skewX(-15deg);
    transition: left 0.55s ease;
  }
  .reserve-btn:hover::after {
    left: 135%;
  }
</style>

