
<style>
  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-title {
    animation: hero-fade-up 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
  }
  .hero-sub {
    animation: hero-fade-up 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
  }
  .hero-cta {
    animation: hero-fade-up 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.6s both;
  }
  .hero-cta:active {
    transform: scale(0.97);
    background-color: #286BE0;
    color: #141414;
    transition:
      transform 0.05s ease,
      background-color 0.05s ease,
      color 0.05s ease;
  }

  @keyframes logo-enter {
    from {
      opacity: 0;
      transform: scale(0.88) translateY(18px);
      filter: drop-shadow(0 0 0px transparent);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0px);
      filter: drop-shadow(0 8px 32px rgba(28, 103, 224, 0.18));
    }
  }

  @keyframes logo-float {
    0%,
    100% {
      transform: translateY(0px);
      filter: drop-shadow(0 8px 32px rgba(28, 93, 224, 0.18));
    }
    50% {
      transform: translateY(-10px);
      filter: drop-shadow(0 18px 40px rgba(28, 146, 224, 0.559));
    }
  }

  .logo-hero {
    animation:
      logo-enter 1s cubic-bezier(0.22, 1, 0.36, 1) both,
      logo-float 6s ease-in-out 1s infinite;
  }
</style>

<section
  id="inicio"
  aria-labelledby="hero-heading"
  class="relative w-full min-h-screen flex items-center overflow-hidden"
>
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <img
      src="/HeroBackground.webp"
      alt=""
      fetchpriority="high"
      loading="eager"
      class="w-full h-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/60"></div>
  </div>

  <div
    class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 py-24 flex flex-col md:flex-row items-center justify-between gap-12"
  >
    <div class="flex flex-col gap-6 max-w-xl">
      <h1
        id="hero-heading"
        class="hero-title text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold leading-tight"
      >
        <span class="text-white"
          >Cortes que hablan por ti <span
            aria-hidden="true"
            style="color:#286BE0;">·</span
          > Barbería en
        </span>
        <span style="color:#286BE0;">Siquirres</span>
      </h1>

      <p
        class="hero-sub text-base sm:text-lg leading-relaxed"
        style="color:rgba(255,255,255,0.70);"
      >
        Cortes, barba y afeitado clásico por manos expertas. Reserva tu cita hoy
        mismo.
      </p>

      <a
        href="#reservar"
        class="hero-cta bg-transparent hover:bg-[#286BE0] text-white hover:text-black inline-flex items-center gap-3 px-8 py-4 text-sm font-semibold tracking-widest uppercase transition-all duration-300 w-fit"
        style="border: 1.5px solid #286BE0;"
      >
        Reservar Cita
        <svg
          width="16"
          height="16"
          viewBox="0 0 16 16"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M1 8h14M9 3l6 5-6 5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
      </a>
    </div>

    <div class="flex-shrink-0 flex items-center justify-center" aria-hidden="true">
      <img
        src="/barber.webp"
        alt=""
        class="logo-hero w-56 sm:w-72 lg:w-80 xl:w-96 object-contain"
      />
    </div>
  </div>

  <div
    class="absolute bottom-0 left-0 right-0 z-10"
    style="height:2px; pointer-events:none;"
  >
    <svg
      width="100%"
      height="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      preserveAspectRatio="none"
    >
      <defs>
        <filter
          id="spray-paint"
          x="0"
          y="0"
          width="100%"
          height="100%"
          color-interpolation-filters="sRGB"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.85 0.28"
            numOctaves="3"
            stitchTiles="stitch"
            result="noise"></feTurbulence>
          <feColorMatrix
            in="noise"
            type="matrix"
            values="0 0 0 0 0.016
                    0 0 0 0 0.196
                    0 0 0 0 0.647
                    0 0 0 26 -12.5"
          ></feColorMatrix>
        </filter>

        <filter
          id="spray-splatter"
          x="0"
          y="0"
          width="100%"
          height="100%"
          color-interpolation-filters="sRGB"
        >
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.35 0.12"
            numOctaves="2"
            seed="7"
            stitchTiles="stitch"
            result="noise"></feTurbulence>
          <feColorMatrix
            in="noise"
            type="matrix"
            values="0 0 0 0 0.196
                    0 0 0 0 0.337
                    0 0 0 0 0.016
                    0 0 0 30 -16"
          ></feColorMatrix>
        </filter>
      </defs>

      <rect width="100%" height="100%" filter="url(#spray-paint)"></rect>

      <rect
        width="100%"
        height="100%"
        filter="url(#spray-splatter)"
        opacity="0.5"></rect>
    </svg>
  </div>
</section>
