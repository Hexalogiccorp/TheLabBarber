<style>
  .section-title {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .section-title.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .title-line {
    margin-top: 10px;
    height: 2px;
    width: 48px;
    background: #e59e48;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.5s;
  }
  .title-line.is-visible {
    transform: scaleX(1);
  }

  .section-subtitle {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.65s ease 0.35s,
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.35s;
  }
  .section-subtitle.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .map-container {
    opacity: 0;
    transform: translateY(28px) scale(0.98);
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.45s,
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.45s;
  }
  .map-container.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<section
  id="ubicacion"
  aria-labelledby="ubicacion-heading"
  class="w-full py-16 px-6 sm:px-10 lg:px-16"
  style="scroll-margin-top:4rem;"
>
  <div class="max-w-7xl mx-auto">
    <header class="mb-10">
      <h2
        id="ubicacion-heading"
        class="section-title text-3xl sm:text-4xl font-bold leading-tight"
        style="color:#F2CEA2;"
      >
        Ubicación
      </h2>
      <div class="title-line" aria-hidden="true"></div>
      <address
        class="section-subtitle mt-3 text-sm sm:text-base not-italic"
        style="color:rgba(255,255,255,0.70);"
      >
        Centro Comercial Los Maderos, diagonal al Pani, segunda planta.,
        Guápiles, Costa Rica
      </address>
    </header>

    <div class="map-container relative w-full overflow-hidden" style="max-width:700px;">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3926.414097404419!2d-83.7781206!3d10.2281474!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa0b96d01b6e551%3A0xb76471f37705802!2sCentro%20de%20Intervenci%C3%B3n%20Temprana%20Pococ%C3%AD-PANI!5e0!3m2!1sen!2scr!4v1782506691430!5m2!1sen!2scr"
        width="100%"
        height="450"
        style="border:0; display:block;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
  </div>
</section>

<script>
  {
    const section = document.getElementById("ubicacion");
    if (section) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.2 },
      );

      section
        .querySelectorAll(
          ".section-title, .title-line, .section-subtitle, .map-container",
        )
        .forEach((el) => {
          observer.observe(el);
        });
    }
  }
</script>
