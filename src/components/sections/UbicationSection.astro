
<style>
  .section-title {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.75s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.75s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .section-title.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .title-line {
    margin-top: 10px;
    height: 2px;
    width: 48px;
    background: #BAE01C;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1) 0.5s;
  }
  .title-line.is-visible {
    transform: scaleX(1);
  }

  .section-subtitle {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.65s ease 0.35s,
      transform 0.65s cubic-bezier(0.22, 1, 0.36, 1) 0.35s;
  }
  .section-subtitle.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .map-container {
    opacity: 0;
    transform: translateY(28px) scale(0.98);
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.45s,
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.45s;
  }
  .map-container.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
</style>

<section id="ubicacion" aria-labelledby="ubicacion-heading" class="w-full py-16 px-6 sm:px-10 lg:px-16" style="scroll-margin-top:4rem;">
  <div class="max-w-7xl mx-auto">

    <header class="mb-10">
      <h2 id="ubicacion-heading" class="section-title text-3xl sm:text-4xl font-bold leading-tight" style="color:#BAE01C;">
        Ubicación
      </h2>
      <div class="title-line" aria-hidden="true"></div>
      <address class="section-subtitle mt-3 text-sm sm:text-base not-italic" style="color:rgba(255,255,255,0.70);">
        Siquirres, de Bar Martel 100 metros norte, local a mano derecha
      </address>
    </header>

    <div class="map-container relative w-full" style="max-width:700px;">

      <div aria-hidden="true" class="absolute left-0 right-0 z-10" style="top:-3px; height:3px; pointer-events:none;">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none">
          <defs>
            <filter id="ms1" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.85 0.28" numOctaves="3" stitchTiles="stitch"/>
              <feColorMatrix type="matrix" values="0 0 0 0 0.196  0 0 0 0 0.337  0 0 0 0 0.016  0 0 0 26 -12.5"/>
            </filter>
          </defs>
          <rect width="100%" height="100%" filter="url(#ms1)"/>
        </svg>
      </div>

      <div aria-hidden="true" class="absolute left-0 right-0 z-10" style="bottom:-3px; height:3px; pointer-events:none;">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none">
          <defs>
            <filter id="ms2" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.85 0.28" numOctaves="3" seed="4" stitchTiles="stitch"/>
              <feColorMatrix type="matrix" values="0 0 0 0 0.196  0 0 0 0 0.337  0 0 0 0 0.016  0 0 0 26 -12.5"/>
            </filter>
          </defs>
          <rect width="100%" height="100%" filter="url(#ms2)"/>
        </svg>
      </div>

      <div aria-hidden="true" class="absolute z-10" style="left:-3px; width:3px; top:-3px; bottom:-3px; pointer-events:none;">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none">
          <defs>
            <filter id="ms3" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.28 0.85" numOctaves="3" seed="6" stitchTiles="stitch"/>
              <feColorMatrix type="matrix" values="0 0 0 0 0.196  0 0 0 0 0.337  0 0 0 0 0.016  0 0 0 26 -12.5"/>
            </filter>
          </defs>
          <rect width="100%" height="100%" filter="url(#ms3)"/>
        </svg>
      </div>

      <div aria-hidden="true" class="absolute z-10" style="right:-3px; width:3px; top:-3px; bottom:-3px; pointer-events:none;">
        <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" preserveAspectRatio="none">
          <defs>
            <filter id="ms4" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
              <feTurbulence type="fractalNoise" baseFrequency="0.28 0.85" numOctaves="3" seed="9" stitchTiles="stitch"/>
              <feColorMatrix type="matrix" values="0 0 0 0 0.196  0 0 0 0 0.337  0 0 0 0 0.016  0 0 0 26 -12.5"/>
            </filter>
          </defs>
          <rect width="100%" height="100%" filter="url(#ms4)"/>
        </svg>
      </div>

      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1172.5120709390171!2d-83.50463138075733!3d10.100774167731045!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8fa7310025725ceb%3A0x38c239034d592670!2sThe%20Lab%20Barber%20Osvaldo!5e1!3m2!1ses-419!2scr!4v1780361262882!5m2!1ses-419!2scr"
        width="100%"
        height="450"
        style="border:0; display:block;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Ubicación The Lab Barber 506"
      ></iframe>
    </div>

  </div>
</section>

<script>
  {
    const section = document.getElementById('ubicacion');
    if (section) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });

      section.querySelectorAll('.section-title, .title-line, .section-subtitle, .map-container').forEach(el => {
        observer.observe(el);
      });
    }
  }
</script>