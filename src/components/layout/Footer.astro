---
const navLinks = [
  { label: "Inicio",    href: "#inicio" },
  { label: "Reservar",  href: "#reservar" },
  { label: "Ubicación", href: "#ubicacion" },
];
---

<footer style="background:#141414; border-top: 2px solid #213D94;">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 py-10">

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 sm:gap-6">

      <!-- Brand column -->
      <div class="flex flex-col gap-4">
        <!-- Logos side by side -->
        <div class="flex items-center gap-3">
          <img
            src="/letteringg.webp"
            alt="The Lab Barber 506"
            class="h-10 w-auto sm:h-12 lg:h-10 xl:h-12 object-contain"
          />
        </div>
        <!-- Description -->
        <p class="text-sm leading-relaxed max-w-xs" style="color:rgba(255,255,255,0.55);">
          Elige tu barbero favorito y agenda en segundos
        </p>
      </div>

      <!-- Navigation column -->
      <div class="flex flex-col gap-4">
        <h3 class="text-sm font-bold tracking-widest uppercase" style="color:#286BE0;">
          Navegación
        </h3>
        <ul class="flex flex-col gap-3">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="footer-nav-link relative text-white text-sm transition-colors duration-200 hover:text-[#286BE0]"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social column -->
      <div class="flex flex-col gap-4">
        <h3 class="text-sm font-bold tracking-widest uppercase" style="color:#286BE0;">
          Redes
        </h3>
        <div class="flex items-center gap-3">
          <!-- TikTok -->
          <a
            href="https://www.tiktok.com/@the.lab.barber1"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok"
            class="flex items-center justify-center w-10 h-10 rounded-full bg-white hover:opacity-80 transition-opacity"
          >
            <svg viewBox="0 0 24 24" width="20" height="20" fill="#000000" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.18 8.18 0 004.78 1.52V6.75a4.85 4.85 0 01-1.01-.06z"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</footer>

<style>
  .footer-nav-link::before {
    content: '';
    position: absolute;
    left: -8px;
    top: 50%;
    transform: translateY(-50%) scaleY(0);
    width: 2px;
    height: 60%;
    background: #286BE0;
    transition: transform 0.15s ease;
  }
  .footer-nav-link.nav-pressed {
    color: #286BE0;
  }
  .footer-nav-link.nav-pressed::before {
    transform: translateY(-50%) scaleY(1);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>(".footer-nav-link").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      link.classList.add("nav-pressed");
      setTimeout(() => {
        link.classList.remove("nav-pressed");
        window.location.href = link.getAttribute("href") ?? "#";
      }, 180);
    });
  });
</script>