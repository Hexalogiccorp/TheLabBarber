---
const navLinks = [
  { label: "Inicio",    href: "#inicio" },
  { label: "Reservar",  href: "#reservar" },
  { label: "Ubicación", href: "#ubicacion" },
];
---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-50 navbar-transparent">
  <nav aria-label="Navegación principal" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">

    <a href="#inicio" aria-label="The Lab Barber 506 — ir al inicio" class="shrink-0">
      <img
        src="/casadelcorte.png"
        aria-hidden="true"
        class="h-6 w-auto sm:h-7 md:h-8 object-contain"
      />
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="nav-desktop-link text-white text-sm font-medium tracking-wide uppercase transition-colors duration-200"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button
      id="menu-btn"
      class="md:hidden flex flex-col gap-1.5 p-2 focus:outline-none"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span aria-hidden="true" class="menu-bar block w-6 h-0.5 bg-[#E59E48] transition-all duration-300 origin-center"></span>
      <span aria-hidden="true" class="menu-bar block w-4 h-0.5 bg-[#E59E48] transition-all duration-300 ml-auto"></span>
      <span aria-hidden="true" class="menu-bar block w-6 h-0.5 bg-[#E59E48] transition-all duration-300 origin-center"></span>
    </button>
  </nav>

  <div id="mobile-menu" aria-hidden="true" class="md:hidden overflow-hidden max-h-0 transition-[max-height] duration-300 ease-in-out border-t border-[#6B4415]/60 bg-[#141414]">
    <ul class="flex flex-col px-6 py-4 gap-4">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link relative block text-white text-sm font-medium tracking-wide uppercase py-2 pl-3 transition-colors duration-200 hover:text-[#EBB470]"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</header>


<style>
  #main-nav {
    transition:
      background-color 0.4s ease,
      border-color 0.4s ease,
      backdrop-filter 0.4s ease;
    border-bottom: 2px solid transparent;
  }
  #main-nav.navbar-transparent {
    background-color: transparent;
    border-color: transparent;
  }
  #main-nav.menu-open {
    background-color: #141414;
    border-color: #6B4415;
  }
  #main-nav.navbar-solid {
    background-color: #141414;
    border-color: #6B4415;
  }

  .nav-desktop-link {
    position: relative;
    padding-bottom: 4px;
  }
  .nav-desktop-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: #E59E48;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .nav-desktop-link:hover {
    color: #EBB470;
  }
  .nav-desktop-link:hover::after {
    transform: scaleX(1);
  }

  .mobile-nav-link::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) scaleY(0);
    width: 2px;
    height: 60%;
    background: #E59E48;
    transition: transform 0.15s ease;
  }
  .mobile-nav-link.nav-pressed {
    color: #EBB470;
  }
  .mobile-nav-link.nav-pressed::before {
    transform: translateY(-50%) scaleY(1);
  }
</style>

<script>
  const nav = document.getElementById("main-nav")!;

  function updateNav() {
    if (window.scrollY > 60) {
      nav.classList.remove("navbar-transparent");
      nav.classList.add("navbar-solid");
    } else {
      nav.classList.remove("navbar-solid");
      nav.classList.add("navbar-transparent");
    }
  }

  window.addEventListener("scroll", updateNav, { passive: true });
  updateNav();

  const menuBtn = document.getElementById("menu-btn")!;
  const mobileMenu = document.getElementById("mobile-menu")!;

  function closeMenu() {
    mobileMenu.style.maxHeight = "0";
    mobileMenu.setAttribute("aria-hidden", "true");
    menuBtn.setAttribute("aria-expanded", "false");
    menuBtn.setAttribute("aria-label", "Abrir menú de navegación");
    menuBtn.classList.remove("open");
    nav.classList.remove("menu-open");
    const bars = menuBtn.querySelectorAll<HTMLElement>(".menu-bar");
    bars[0].style.transform = "";
    bars[1].style.opacity = "";
    bars[2].style.transform = "";
  }

  menuBtn.addEventListener("click", () => {
    const bars = menuBtn.querySelectorAll<HTMLElement>(".menu-bar");
    menuBtn.classList.toggle("open");

    if (menuBtn.classList.contains("open")) {
      mobileMenu.style.maxHeight = mobileMenu.scrollHeight + "px";
      mobileMenu.setAttribute("aria-hidden", "false");
      menuBtn.setAttribute("aria-expanded", "true");
      menuBtn.setAttribute("aria-label", "Cerrar menú de navegación");
      nav.classList.add("menu-open");
      bars[0].style.transform = "rotate(45deg) translate(5px, 6px)";
      bars[1].style.opacity = "0";
      bars[2].style.transform = "rotate(-45deg) translate(5px, -6px)";
    } else {
      closeMenu();
    }
  });

  mobileMenu.querySelectorAll<HTMLElement>(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", (e) => {
      e.preventDefault();
      link.classList.add("nav-pressed");
      setTimeout(() => {
        link.classList.remove("nav-pressed");
        closeMenu();
        window.location.href = link.getAttribute("href") ?? "#";
      }, 180);
    });
  });
</script>
